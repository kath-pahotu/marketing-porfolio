# Publish only the site and its content/build sources.
/*
!/.gitignore
!/README.md
!/build_website.py
!/requirements.txt
!/vercel.json
!/source/
/source/*
!/source/content.py
!/source/build_site.py
!/source/refine_site.py
!/source/refinements.css
!/website/
.vercel/
node_modules/
__pycache__/
*.pyc
.env
.env.*
.dev.vars

!/source/revamp_content.py
!/source/build_tracks.py
!/source/build_cvs.py
!/source/revamp.css
!/source/revamp.js

!/source/business_context.py
!/source/business.css

!/source/business_explorer.py
!/source/business-explorer.css
!/source/business-explorer.js
!/source/portrait.css
!/source/section_experiences.py
!/source/section-experiences.css
!/source/section-experiences.js
.vercel
